Problema 2: Promedio de 10 enteros
​1. Fase de Diseño (Pseudocódigo)
Inicio
    Declarar arreglo datos[10] de entero
    Declarar suma = 0 de entero
    Declarar promedio de real
    
    Para i = 0 Hasta 9 Con Paso 1 Hacer
        Escribir "Ingrese número:"
        Leer datos[i]
        suma = suma + datos[i]
    FinPara
    
    promedio = suma / 10.0
    Escribir "El promedio es: ", promedio
Fin

2. Fase de Implementación (Código en C++)
#include <iostream>
using namespace std;

int main() {
    int datos[10];
    int suma = 0;

    for (int i = 0; i < 10; i++) {
        cout << "Ingrese dato " << i + 1 << ": ";
        cin >> datos[i];
        suma += datos[i];
    }

    double promedio = suma / 10.0;
    cout << "El promedio es: " << promedio << endl;
    return 0;
}
