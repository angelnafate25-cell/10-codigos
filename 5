Problema 5: Reemplazar impares por -1
Fase de Diseño (Pseudocódigo)
Inicio
    Declarar N de entero
    Escribir "Ingrese tamaño N:"
    Leer N
    Declarar arreglo datos[N] de entero
    
    Para i = 0 Hasta N - 1 Con Paso 1 Hacer
        Escribir "Ingrese valor:"
        Leer datos[i]
        Si datos[i] % 2 != 0 Entonces
            datos[i] = -1
        FinSi
    FinPara
    
    Escribir "Arreglo modificado:"
    Para i = 0 Hasta N - 1 Con Paso 1 Hacer
        Escribir datos[i]
    FinPara
Fin

Fase de Implementación (Código en C++
#include <iostream>
using namespace std;

int main() {
    int N;
    cout << "Ingrese el tamaño N: ";
    cin >> N;

    int datos[N];
    for (int i = 0; i < N; i++) {
        cout << "Elemento " << i << ": ";
        cin >> datos[i];
        if (datos[i] % 2 != 0) {
            datos[i] = -1;
        }
    }

    cout << "Resultado: ";
    for (int i = 0; i < N; i++) {
        cout << datos[i] << " ";
    }
    cout << endl;
    return 0;
}
