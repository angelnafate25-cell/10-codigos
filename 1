Problema 1: Suma de 5 elementos de un arreglo
​1. Fase de Diseño (Pseudocódigo)
Inicio
    Declarar arreglo numeros[5] de entero
    Declarar suma = 0 de entero
    
    Para i = 0 Hasta 4 Con Paso 1 Hacer
        Escribir "Ingrese un número:"
        Leer numeros[i]
        suma = suma + numeros[i]
    FinPara
    
    Escribir "La suma total es: ", suma
Fin

2. Fase de Implementación (Código en C++)
#include <iostream>
using namespace std;

int main() {
    int numeros[5];
    int suma = 0;

    for (int i = 0; i < 5; i++) {
        cout << "Ingrese el numero " << i + 1 << ": ";
        cin >> numeros[i];
        suma += numeros[i];
    }

    cout << "La suma total es: " << suma << endl;
    return 0;
}
